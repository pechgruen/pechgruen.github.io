---
import BaseLayout from "../../layouts/BaseLayout.astro";
import textHtml from "../../assets/texte/a-hooch-aaf-unna-dorf.html?raw";
import houseLinks from "../../data/house-links.json";

export const chronik = {
  title: "A Hooch aaf unna Dorf uu d' Pechgräina Leit",
  subtitle: "Erzählt und aufgeschrieben von Erich Heinzl",
  date: "2025-12-21",
  updated: "2026-02-21",
  bereich: "Texte, Stimmen und Erinnerungen",
  href: "/texte/a-hooch-aaf-unna-dorf",
  order: 1,
};

const sourceShort =
  "Aus: Pechgrün am Fuße des Erzgebirges – ein verschüttetes Dorf. Geschichte und Erinnerungen, Band 3 (1998), hg. von Anton Strunz und Erich Heinzl.";

function escapeHtml(s: string): string {
  return s
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function linkPersons(rawHtml: string): string {
  // Matches: [[I500020|Name]] or [[?|Name]]
  const re = /\[\[([A-Za-z]\d+|\?)\|([^\]]+?)\]\]/g;

  const missingNote =
    "Nicht im Pechgrün-Stammbaum erfasst.\n" +
    "Keine familiäre Verbindung zu den Pechgrüner Stammlinien.";

  return rawHtml.replace(re, (_match, key, label) => {
    const safeLabel = escapeHtml(label);

    if (key === "?") {
      const safeNote = escapeHtml(missingNote);
      return `<span class="person-link person-missing" data-note="${safeNote}">${safeLabel}</span>`;
    }

    const safeId = encodeURIComponent(key);
    return `<a href="/internal/ged-person?id=${safeId}" class="person-link" target="_blank" rel="noopener">${safeLabel}</a>`;
  });
}

function linkHouseNumbers(rawHtml: string): string {
  const map = houseLinks as Record<string, string>;

  const re = /\b(Haus\s+)?Nr\.\s*(\d{1,3})\b/g;

  return rawHtml.replace(re, (match, _hausPrefix, num) => {
    const href = map[String(num)];
    if (!href) return match;

    return `<a href="${href}" class="house-link" target="_blank" rel="noopener">${match}</a>`;
  });
}

const textHtmlLinked = linkHouseNumbers(linkPersons(textHtml));
---

<BaseLayout title={chronik.title}>
  <article class="text-ort">
    <header class="head">
      <h1>{chronik.title}</h1>
      <p class="subtitle">{chronik.subtitle}</p>

      <p class="meta">
        <span class="source">{sourceShort}</span>
      </p>

      <p class="meta">
        Hinweis: Namen und Hausnummern im Text sind anklickbar. Sie führen zu
        weiterführenden Informationen im Stammbaum sowie zu den
        Wegbeschreibungen, in denen die Häuser näher beschrieben sind.
      </p>
    </header>

    <section class="text" lang="de" set:html={textHtmlLinked} />

    <script is:inline>
      (function () {
        const sp = new URLSearchParams(window.location.search);
        const pid = sp.get("pid");
        if (!pid) return;

        // Collect candidates. Prefer explicit class, fallback to href prefix.
        const preferred = document.querySelectorAll("a.person-link");
        const candidates = preferred.length
          ? preferred
          : document.querySelectorAll('a[href^="/internal/ged-person?id="]');

        // Filter hits by id=... param (robust for relative hrefs)
        const hits = Array.from(candidates).filter((a) => {
          const href = a.getAttribute("href") || "";
          try {
            const u = new URL(href, window.location.href);
            return u.searchParams.get("id") === pid;
          } catch {
            return false;
          }
        });

        if (hits.length === 0) return;

        // ---------- UI ----------
        const bar = document.createElement("div");
        bar.className = "findbar";
        bar.innerHTML = `
          <div class="findbar-inner">
            <div class="findbar-box">
              <span class="count">1 / ${hits.length}</span>
              <button type="button" data-action="prev" aria-label="Previous match">◀</button>
              <button type="button" data-action="next" aria-label="Next match">▶</button>
              <button type="button" data-action="close" aria-label="Close">✕</button>
            </div>
          </div>
        `;
        document.body.appendChild(bar);

        const countEl = bar.querySelector(".count");

        let idx = 0;

        function setActive(nextIdx, scroll = true) {
          idx = nextIdx;

          // mark all once
          // (safe even if called multiple times)
          hits.forEach((a) => a.classList.add("mention-hit"));

          // switch active
          hits.forEach((a) => a.classList.remove("mention-active"));
          const active = hits[idx];
          active.classList.add("mention-active");

          // update count
          countEl.textContent = `${idx + 1} / ${hits.length}`;

          if (scroll) {
            active.scrollIntoView({ behavior: "smooth", block: "center" });
            // optional focus without jumping
            // try { active.focus({ preventScroll: true }); } catch {}
          }
        }

        function next() {
          setActive((idx + 1) % hits.length);
        }

        function prev() {
          setActive((idx - 1 + hits.length) % hits.length);
        }

        function cleanup() {
          // remove UI
          bar.remove();

          // remove classes
          hits.forEach((a) => {
            a.classList.remove("mention-hit");
            a.classList.remove("mention-active");
          });

          // remove listeners
          window.removeEventListener("keydown", onKey);
          bar.removeEventListener("click", onClick);

          // optional: remove pid from URL (comment out if you want to keep it)
          // const url = new URL(window.location.href);
          // url.searchParams.delete("pid");
          // history.replaceState({}, "", url);
        }

        function onClick(e) {
          const btn = e.target.closest("button[data-action]");
          if (!btn) return;
          const action = btn.getAttribute("data-action");
          if (action === "next") next();
          else if (action === "prev") prev();
          else if (action === "close") cleanup();
        }

        function onKey(e) {
          // Don’t hijack typing in inputs, just in case
          const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : "";
          if (tag === "input" || tag === "textarea" || tag === "select") return;

          if (e.key === "Escape") {
            e.preventDefault();
            cleanup();
          } else if (e.key === "ArrowRight" || e.key === "ArrowDown") {
            e.preventDefault();
            next();
          } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
            e.preventDefault();
            prev();
          }
        }

        bar.addEventListener("click", onClick);
        window.addEventListener("keydown", onKey);

        // start
        setActive(0, true);
      })();
    </script>

  </article>
</BaseLayout>

<style>
  /* ===== Grundlayout ===== */
  .text-ort {
    width: min(860px, 100%);
    margin-left: 0;
    margin-right: auto;
  }

  /* ===== Kopf ===== */
  .head {
    margin-bottom: 1.6rem;
  }

  .subtitle {
    margin: -0.35rem 0 0.9rem 0;
    font-size: 1.15rem;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.72);
  }

  .meta {
    margin: 0 0 0.9rem 0;
    font-size: 0.95rem;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.6);
  }

  .usage-hint {
    margin: 0 0 1.4rem 0;
    font-size: 0.95rem;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.6);
  }

  /* ===== Fließtext ===== */
  .text {
    margin-top: 1.6rem;
    font-size: 1.08rem;
    line-height: 1.75;

    /* Buchsatz */
    text-align: left;
    hyphens: auto;
    -webkit-hyphens: auto;
    -ms-hyphens: auto;

    /* Seitenzähler */
    counter-reset: page;
  }

  .text :global(p) {
    margin: 0 0 0.9rem 0;
    hyphens: none;
    word-break: normal;
    overflow-wrap: break-word;
    word-spacing: 0.03em;
    line-height: 1.55;
  }

  /* ===== Abschnitt / "Seite" =====
     Alle 5 Absätze:
     - deutlicher Abstand
     - feine Linie
     - Seitenzahl rechts, oberhalb der Linie
  */
  .text :global(p:nth-of-type(5n + 1)) {
    margin-top: 6rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);

    position: relative;
    counter-increment: page;
  }

  .text :global(p:nth-of-type(5n + 1))::before {
    content: counter(page);
    position: absolute;
    right: 0;
    top: -20px;

    font-size: 0.8rem;
    line-height: 1;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.28);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;

    background: white;
    padding-left: 0.5rem;
  }

  /* Erste Seite ohne Linie / Zahl */
  .text :global(p:nth-of-type(1)) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .text :global(p:nth-of-type(1))::before {
    content: none;
  }

  :global(.text-ort .text a.person-link) {
    text-decoration: none !important;
    color: inherit !important;
    font-weight: 500; /* minimal stärker als normal (400) */
  }

  :global(.text-ort .text a.person-link:hover),
  :global(.text-ort .text a.person-link:focus-visible) {
    text-decoration: underline !important;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  :global(.text-ort .text a.house-link) {
    text-decoration: none !important;
    color: inherit !important;
    font-weight: 500;
  }

  :global(.text-ort .text a.house-link:hover),
  :global(.text-ort .text a.house-link:focus-visible) {
    text-decoration: underline !important;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* "?"-Personen: kein Link, aber Hover-Hinweis */
  :global(.text-ort .text .person-missing) {
    position: relative;
    cursor: help;
    font-weight: 500; /* gleiche leichte Betonung */
  }

  :global(.text-ort .text .person-missing:hover::after) {
    content: attr(data-note);
    position: absolute;
    left: 0;
    top: 1.4em;
    z-index: 50;

    /* Breite erzwingen (und trotzdem viewport-sicher) */
    width: 36ch;
    max-width: 90vw;

    white-space: pre-line;
    box-sizing: border-box;

    padding: 0.6em 0.8em;
    border-radius: 10px;

    background: rgba(55, 55, 55, 0.92);
    color: white;

    font-size: 0.92em;
    line-height: 1.35;
  }

  :global(.text-ort .text .person-missing:hover::before) {
    content: "";
    position: absolute;
    left: 0.8em;
    top: 1.15em;
    border: 6px solid transparent;
    border-bottom-color: rgba(0, 0, 0, 0.92);
    z-index: 51;
  }

  /* ===== Mention find-mode (A Hooch) ===== */
  :global(.mention-hit) {
    background: rgba(255, 235, 59, 0.55); /* gelb */
    border-radius: 4px;
    padding: 0 2px;
  }

  :global(.mention-active) {
    background: rgba(255, 140, 0, 0.55); /* orange */
    border-radius: 4px;
    padding: 0 2px;
  }

  /* Outer: spans viewport */
  :global(.findbar) {
    position: fixed;
    top: calc(32px + 14px);
    left: 0 !important;
    right: 0 !important;
    z-index: 999999 !important;
    pointer-events: none;
  }

  /* Inner: aligns to the same 980px container as header/main */
  :global(.findbar-inner) {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1.25rem; /* same as .main and .header-inner */
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }

  /* Box: the actual visible widget */
  :global(.findbar-box) {
    pointer-events: auto;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 8px 10px;
    border-radius: 12px;

    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);

    font-size: 0.92rem;
    line-height: 1;
    color: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(8px);
  }

  /* keep your existing rules – just target box scope */
  :global(.findbar-box .count) {
    font-variant-numeric: tabular-nums;
    min-width: 5.5ch;
    text-align: center;
  }

  :global(.findbar-box button) {
    appearance: none;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background: white;
    color: inherit;

    padding: 6px 9px;
    border-radius: 10px;
    cursor: pointer;

    line-height: 1;
  }

  :global(.findbar-box button:hover) {
    background: rgba(0, 0, 0, 0.04);
  }

  :global(.findbar-box button:active) {
    transform: translateY(1px);
  }

  /* ===== PATCH: enforce highlight + remove ugly focus ring ===== */

  /* Make sure background wins against link styles */
  :global(a.mention-hit),
  :global(.mention-hit) {
    background: rgba(255, 235, 59, 0.55) !important;
    text-decoration: none !important;
  }

  /* Active: orange + a bit more emphasis */
  :global(a.mention-active),
  :global(.mention-active) {
    background: rgba(255, 140, 0, 0.55) !important;
    box-shadow: 0 0 0 2px rgba(255, 140, 0, 0.35) !important;
  }

  /* Kill browser focus outline/box that looks like a frame */
  :global(a.mention-hit:focus),
  :global(a.mention-hit:focus-visible),
  :global(a.mention-active:focus),
  :global(a.mention-active:focus-visible) {
    outline: none !important;
    box-shadow: none !important;
  }

  /* Ensure the findbar is always on top and clickable */
  :global(.findbar) {
    z-index: 999999 !important;
    pointer-events: auto;
  }
</style>
