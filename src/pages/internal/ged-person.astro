---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const chronik = {
  title: "Personen- und Familienbericht",
  subtitle: "Lebensdaten und familiäre Beziehungen einer Person",
  date: "2026-01-24",
  updated: "2026-02-10",
  bereich: "Personen",
  href: "/internal/ged-person",
  order: 22,
};
---

<BaseLayout title={`${chronik.title} – Person`}>
  <article class="page ged-page">
    <!-- STATIC PAGE HEADER (never touched by JS) -->
    <header class="head">
      <h1>{chronik.title}</h1>
      <p class="subtitle">{chronik.subtitle}</p>
      <p class="meta">{chronik.date}</p>
    </header>

    <!-- DYNAMIC PERSON HEADER -->
    <div class="person-head">
      <div class="personName" id="personName">…</div>
      <div class="personLines" id="personLines">
        <div class="line">…</div>
      </div>
    </div>

    <div class="navhint muted">
      Tipp: Klick auf einen Namen führt zur jeweiligen Person.
    </div>

    <hr class="sep section-sep" />

    <div class="ged-person">
      <!-- UNIONS + CHILDREN -->
      <section class="block" id="blockUnions">
        <div class="blockBody" id="unionsBody">
          <div class="placeholder">Lade Daten …</div>
        </div>
      </section>

      <!-- PARENTS + SIBLINGS -->
      <section class="block" id="blockParents" style="margin-top: 14px;">
        <div class="blockBody" id="parentsBody">
          <div class="placeholder">Lade Daten …</div>
        </div>
      </section>

      <!-- IMPORTANT: this is the “global bottom separator” -->
      <hr id="gedEndSep" class="sep section-sep" />
    </div>

    <!-- SCOPE HINT (universal, same text; triggered only for potential “why?” moments) -->
    <div
      id="scopeHint"
      class="navhint muted"
      style="display:none; margin-top: 1.2rem;"
    >
      <div>Hinweis:</div>
      <div>
        Diese Darstellung zeigt familiäre Beziehungen im Ortskontext von
        Pechgrün und Neuhäusern. Personen ohne direkten Ortsbezug können
        enthalten sein, wenn sie in enger familiärer Beziehung stehen.
        Weitergehende Verwandtschaft sowie einzelne familiäre Angaben werden
        hier bewusst nicht dargestellt oder sind historisch nicht überliefert.
      </div>
    </div>
  </article>

  <style is:global>
    .ged-page.page {
      width: 100%;
      margin: 0;
    }

    /* --- header spacing like your “good” slug --- */
    .ged-page .head {
      margin-bottom: 1.1rem;
    }
    .ged-page .head h1 {
      margin: 0 0 0.25rem 0;
    }
    .ged-page .head .subtitle {
      margin: 0 0 0.4rem 0;
      color: rgba(0, 0, 0, 0.65);
      font-size: 1.05rem;
    }
    .ged-page .head .meta {
      margin: 0;
      font-size: 0.85rem;
      color: rgba(0, 0, 0, 0.45);
    }

    /* --- dynamic person header (content) --- */
    .ged-page .person-head {
      max-width: 1100px;
      margin: 0 auto 0.9rem auto;
      padding: 0;
      color: rgba(0, 0, 0, 0.81);
      font-size: 1rem;
    }

    .ged-page .legInline {
      font-size: 1rem;
      font-weight: 400;
      color: rgba(0, 0, 0, 0.81);
    }

    .ged-page .personName {
      font-weight: 700;
      font-size: 1.3rem;
      line-height: 1.15;
      margin: 0 0 0.25rem 0;
      color: #000;
    }

    .ged-page .personLines .line {
      margin: 0;
      padding: 0;
      line-height: 1.25;
      font-size: inherit;
      color: rgba(0, 0, 0, 0.81);
    }

    .ged-page .navhint {
      max-width: 1100px;
      margin: 0 auto 0.6rem auto;
      font-size: 0.92rem;
      color: rgba(0, 0, 0, 0.65);
    }

    /* --- main content --- */
    .ged-page .ged-person {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0;
      color: #000;
      font-size: 1rem;
    }

    .ged-page .muted {
      color: rgba(0, 0, 0, 0.55);
      font-size: 13px;
    }

    /* ------------------------------
       CONSISTENT SEPARATOR SPACING
       ------------------------------ */

    /* HR controls spacing (single source of truth) */
    .ged-page hr.section-sep {
      margin: 0.75rem 0; /* adjust once */
    }

    /* Remove “margin leakage” into separators */
    .ged-page .blockBody > :first-child,
    .ged-page .unionContent > :first-child {
      margin-top: 0 !important;
    }

    .ged-page .blockBody > :last-child,
    .ged-page .unionContent > :last-child {
      margin-bottom: 0 !important;
    }

    /* --- blocks --- */
    .ged-page .block {
      margin: 0;
    }

    /* Headings inside content — tight */
    .ged-page h3 {
      margin: 0.65rem 0 0.1rem 0;
      font-size: 1.2rem;
      font-weight: 700;
      color: #000;
    }

    /* If a block starts right after a separator, don't add extra top margin */
    .ged-page .blockBody > h3:first-child,
    .ged-page .unionContent > h3:first-child {
      margin-top: 0 !important;
    }

    /* Label lines (Vater/Mutter, Heirat, partner line) */
    .ged-page .kv {
      margin: 0.06rem 0;
      line-height: 1.22;
      color: rgba(0, 0, 0, 0.81);
      font-size: inherit;
    }

    /* Labels */
    .ged-page .k {
      font-weight: 400;
      color: rgba(0, 0, 0, 0.81);
    }

    /* Names bold */
    .ged-page .pname {
      font-weight: 700;
      color: rgba(0, 0, 0, 0.81);
    }

    /* Links: black, no underline */
    .ged-page a.plink,
    .ged-page a.plink:visited,
    .ged-page a.plink:hover,
    .ged-page a.plink:active {
      color: rgba(0, 0, 0, 0.81) !important;
      text-decoration: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      background: none !important;
      background-image: none !important;
      cursor: pointer;
    }
    .ged-page a.plink * {
      text-decoration: none !important;
    }

    /* Bullets */
    .ged-page ul.bullets {
      list-style: none !important;
      margin: 0.1rem 0 1.1rem 0;
      padding: 0;
    }
    .ged-page ul.bullets li {
      margin: 0.1rem 0;
      line-height: 1.22;
      color: rgba(0, 0, 0, 0.81);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;

      position: relative;
      padding-left: 1.05rem;
      font-size: inherit;
    }
    .ged-page ul.bullets li::before {
      content: "•";
      position: absolute;
      left: 0;
      top: 0;
      line-height: 1.22;
    }

    /* Unions: HR margin controls spacing */
    .ged-page .union-sep {
      margin: 0;
    }
    .ged-page .unionContent {
      padding-bottom: 0;
    }
    .ged-page .unionContent ul.bullets {
      margin-bottom: 0;
    }

    /* Normaler Inhaltstext für Platzhalter (kein Tooltip-Stil!) */
    .ged-page .placeholder {
      color: rgba(0, 0, 0, 0.81);
      font-size: 1rem;
      line-height: 1.22;
      margin: 0.06rem 0;
    }

    /* Optische Luft vor der Linie: erzeugt Abstand nach oben, ohne Content-Margins anzufassen */
    .ged-page hr.section-sep {
      display: block;
      padding-top: 0.25rem;   /* mehr Luft oberhalb */
      margin-top: 1.3rem;    /* bleibt wie bisher */
      margin-bottom: 0.50rem; /* bleibt wie bisher */
      border: none;
      border-top: 1px solid rgba(0,0,0,0.18);
    }

    @media (max-width: 900px) {
      .ged-page ul.bullets li {
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
      }
    }
  </style>

  <script type="module">
    const DATA_BASE = "/data/ged";
    const $ = (id) => document.getElementById(id);

    const AUTO_DEAD_AGE = 100;

    // For scope-hint trigger A (no visible place reference)
    const SCOPE_PLACES = ["Pechgrün", "Neuhäuser"].map((s) => s.toLowerCase());

    let showScopeHint = false;

    function renderScopeHint() {
      const el = $("scopeHint");
      if (!el) return;
      el.style.display = showScopeHint ? "block" : "none";
    }

    function qsGet(key) {
      return new URL(location.href).searchParams.get(key);
    }

    function shortPlace(place) {
      if (!place) return "";
      return place
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean)
        .slice(0, 2)
        .join(", ");
    }

    function fmtEvent(prefix, ev, { useShortPlace = false } = {}) {
      const d = ev?.date || "?";
      const p = ev?.place || "";
      const pp = useShortPlace ? shortPlace(p) : p;
      return pp ? `${prefix} ${d} in ${pp}` : `${prefix} ${d}`;
    }

    function birthYear(p) {
      const s = p?.birth?.date || "";
      const m = String(s).match(/\b(\d{4})\b/);
      return m ? parseInt(m[1], 10) : null;
    }

    function isDead(p) {
      const deadByData = Boolean(
        p?.death?.known || p?.death?.date || p?.death?.place || p?.death?.year
      );
      if (deadByData) return true;

      const by = birthYear(p);
      if (by == null) return false;

      const age = new Date().getFullYear() - by;
      return age > AUTO_DEAD_AGE;
    }

    function fmtLifeInline(p, { useShortPlace = true } = {}) {
      const b = fmtEvent("*", p?.birth, { useShortPlace });
      if (!isDead(p)) return b;

      const hasDetails = Boolean(p?.death?.date || p?.death?.place);
      const d = hasDetails ? fmtEvent("†", p?.death, { useShortPlace }) : "† ?";
      return `${b}, ${d}`;
    }

    function linkToPerson(pid, sn, az) {
      return `/internal/ged-person?id=${encodeURIComponent(pid)}&sn=${encodeURIComponent(sn || "")}&az=${encodeURIComponent(az || "")}`;
    }

    function personLinkHtml(
      people,
      pid,
      sn,
      az,
      { useShortPlace = true } = {}
    ) {
      if (!pid) return `<span class="muted">unbekannt</span>`;
      const p = people[pid];
      if (!p)
        return `<span class="muted">${pid} (außerhalb des Subsets)</span>`;

      const href = linkToPerson(pid, sn, az);
      const life = fmtLifeInline(p, { useShortPlace });
      const leg = p?.name?.legitimized
        ? `<span class="legInline"> (leg.)</span>`
        : "";

      return `
        <a class="plink" href="${href}">
          <span class="pname">${p.name.display}</span>${leg}, ${life}
        </a>
      `.trim();
    }

    function marriageLineHtml(f, { useShortPlace = false } = {}) {
      const present = Boolean(
        f?.marriage?.present === true || f?.marriage?.date || f?.marriage?.place
      );
      if (!present) return "";

      const d = f?.marriage?.date || "?";
      const p = f?.marriage?.place || "";
      const pp = useShortPlace ? shortPlace(p) : p;
      const tail = pp ? `${d} in ${pp}` : `${d}`;
      return `<div class="kv"><span class="k">Heirat:</span> ${tail}</div>`;
    }

    function parseYear(dateStr) {
      if (!dateStr) return null;
      const m = String(dateStr).match(/\b(\d{4})\b/);
      return m ? parseInt(m[1], 10) : null;
    }

    function unionChildrenMaxYear(f, people) {
      let maxY = null;
      const kids = (f?.children || []).filter(Boolean);
      for (const cid of kids) {
        const y = parseYear(people[cid]?.birth?.date);
        if (y != null && (maxY == null || y > maxY)) maxY = y;
      }
      return maxY;
    }

    function spouseBirthYear(f, people) {
      const wid = f?.wife;
      return wid ? parseYear(people[wid]?.birth?.date) : null;
    }

    function ordinalDE(n) {
      const map = {
        1: "Erster",
        2: "Zweiter",
        3: "Dritter",
        4: "Vierter",
        5: "Fünfter",
        6: "Sechster",
        7: "Siebter",
        8: "Achter",
        9: "Neunter",
        10: "Zehnter",
      };
      return map[n] || `${n}.`;
    }

    function unionsPlaceholderHtml() {
      return `
        <h3>Partner</h3>
        <div class="placeholder">Keine Angaben zu Partnern oder Kindern vorhanden.</div>
        <hr class="sep section-sep union-sep" />
      `.trim();
    }

    async function load() {
      const id = qsGet("id");
      const sn = qsGet("sn");
      const az = qsGet("az");

      let noUnionsShown = false;

      try {
        const personNameEl = $("personName");
        const personLinesEl = $("personLines");

        if (!id) {
          personNameEl.textContent = "Keine Person gewählt.";
          personLinesEl.innerHTML = "";
          $("unionsBody").innerHTML = ``;
          $("parentsBody").innerHTML = ``;
          showScopeHint = false;
          return;
        }

        const [people, families] = await Promise.all([
          fetch(`${DATA_BASE}/people.json`).then((r) => r.json()),
          fetch(`${DATA_BASE}/families.json`).then((r) => r.json()),
        ]);

        const p = people[id];
        if (!p) {
          personNameEl.textContent = `Nicht im Set: ${id}`;
          personLinesEl.innerHTML = `<div class="muted">Diese Person ist im aktuellen Datenbestand nicht enthalten.</div>`;
          $("unionsBody").innerHTML = ``;
          $("parentsBody").innerHTML = ``;
          // If person is outside the subset, show a scope hint (A is effectively true here)
          showScopeHint = true;
          return;
        }

        /* ---------------- Person Head ---------------- */

        const nick = (p.nickname || "").trim();

        if (nick) {
          const given = (p.name?.given || "").trim();
          const display = String(p.name?.display || "").trim();

          if (given && display.startsWith(given + " ")) {
            personNameEl.textContent = `${given} "${nick}"${display.slice(given.length)}`;
          } else {
            personNameEl.textContent = `${display} "${nick}"`.trim();
          }
        } else {
          personNameEl.textContent = p.name.display;
        }

        if (p?.name?.legitimized) {
          const leg = document.createElement("span");
          leg.className = "legInline";
          leg.textContent = " (leg.)";
          personNameEl.appendChild(leg);
        }

        const bLine = fmtEvent("*", p.birth, { useShortPlace: false });

        let dLine = "";
        if (isDead(p)) {
          const hasDetails = Boolean(p.death?.date || p.death?.place);
          dLine = hasDetails
            ? fmtEvent("†", p.death, { useShortPlace: false })
            : "† ?";
        }

        const houseLine = p.houseName ? `Hausname: ${p.houseName}` : "";
        const occLine = p.occupation ? `Beruf: ${p.occupation}` : "";

        personLinesEl.innerHTML = `
          <div class="line">${bLine}</div>
          ${dLine ? `<div class="line">${dLine}</div>` : ``}
          ${houseLine ? `<div class="line">${houseLine}</div>` : ``}
          ${occLine ? `<div class="line">${occLine}</div>` : ``}
        `;

        /* ---------------- UNIONS ---------------- */

        const rawFams = (p.fams || [])
          .map((fid) => families[fid])
          .filter(Boolean);

        if (!rawFams.length) {
          $("unionsBody").innerHTML = unionsPlaceholderHtml();
          noUnionsShown = true;
        } else {
          const decorated = rawFams.map((f, idx) => {
            const marriageY = parseYear(f?.marriage?.date);
            const kidsMaxY = unionChildrenMaxYear(f, people);
            const wifeY = spouseBirthYear(f, people);
            return { f, idx, marriageY, kidsMaxY, wifeY };
          });

          decorated.sort((a, b) => {
            if (a.marriageY != null && b.marriageY != null)
              return a.marriageY - b.marriageY;
            if (a.marriageY != null) return -1;
            if (b.marriageY != null) return 1;

            if (a.kidsMaxY != null && b.kidsMaxY != null)
              return a.kidsMaxY - b.kidsMaxY;
            if (a.kidsMaxY != null) return -1;
            if (b.kidsMaxY != null) return 1;

            if (a.wifeY != null && b.wifeY != null) return a.wifeY - b.wifeY;
            if (a.wifeY != null) return -1;
            if (b.wifeY != null) return 1;

            return a.idx - b.idx;
          });

          const fams = decorated.map((x) => x.f);

          const isMarriedUnion = (f) =>
            Boolean(
              f?.marriage?.present === true ||
              f?.marriage?.date ||
              f?.marriage?.place
            );

          const marriedTotal = fams.filter(isMarriedUnion).length;
          let marriedSeen = 0;

          let anyUnionRendered = false;

          const unionsHtml = fams
            .map((f) => {
              const partnerId = f.husband === id ? f.wife : f.husband;
              const partnerInSet = Boolean(partnerId && people[partnerId]);

              const kidsInSet = (f.children || []).filter(
                (cid) => cid && people[cid]
              );

              // If partner is outside subset AND no kids in subset, this union adds nothing.
              // We skip it to avoid noise; if all unions are skipped, we show a placeholder.
              if (!partnerInSet && kidsInSet.length === 0) {
                return ``;
              }

              anyUnionRendered = true;

              let heading = "";
              if (!partnerInSet) {
                heading = "Partner unbekannt";
              } else {
                const married = isMarriedUnion(f);
                if (married) {
                  marriedSeen += 1;
                  heading =
                    marriedTotal > 1
                      ? `${ordinalDE(marriedSeen)} Ehepartner`
                      : "Ehepartner";
                } else {
                  heading = "Partner (nicht verheiratet)";
                }
              }

              const partnerLine = partnerInSet
                ? `<div class="kv">${personLinkHtml(people, partnerId, sn, az, { useShortPlace: true })}</div>`
                : ``;

              const marriageLine = marriageLineHtml(f, {
                useShortPlace: false,
              });

              let kidsBlock = ``;
              if (kidsInSet.length > 0) {
                kidsBlock = `
                  <h3>Kinder</h3>
                  <ul class="bullets">
                    ${kidsInSet
                      .map(
                        (cid) =>
                          `<li>${personLinkHtml(people, cid, sn, az, { useShortPlace: true })}</li>`
                      )
                      .join("")}
                  </ul>
                `;
              } else {
                kidsBlock = `
                  <h3>Kinder</h3>
                  <div class="placeholder">Keine Angaben zu Kindern vorhanden.</div>
                `;
              }

              return `
                <div class="unionBlock">
                  <div class="unionContent">
                    <h3>${heading}</h3>
                    ${partnerLine}
                    ${marriageLine}
                    ${kidsBlock}
                  </div>
                  <hr class="sep section-sep union-sep" />
                </div>
              `;
            })
            .join("");

          if (!anyUnionRendered) {
            $("unionsBody").innerHTML = unionsPlaceholderHtml();
            noUnionsShown = true;
          } else {
            $("unionsBody").innerHTML = unionsHtml.trim();
          }
        }

        /* ---------------- PARENTS + SIBLINGS ---------------- */

        const famc = p.famc && p.famc.length ? p.famc[0] : null;
        const pf = famc ? families[famc] : null;

        const fatherId = pf?.husband || null;
        const motherId = pf?.wife || null;
        const siblingIds = (pf?.children || []).filter(
          (cid) => cid && cid !== id
        );

        const fatherInSet = Boolean(fatherId && people[fatherId]);
        const motherInSet = Boolean(motherId && people[motherId]);

        const fatherHtml = fatherInSet
          ? personLinkHtml(people, fatherId, sn, az, { useShortPlace: true })
          : `<span class="muted">—</span>`;

        const motherHtml = motherInSet
          ? personLinkHtml(people, motherId, sn, az, { useShortPlace: true })
          : `<span class="muted">—</span>`;

        // Show parents' marriage ONLY if at least one parent is actually visible in the subset.
        // Otherwise we would get: Vater: — / Mutter: — / Heirat: ...  (confusing / misleading)
        const parentsMarriageHtml =
          pf && (fatherInSet || motherInSet)
            ? marriageLineHtml(pf, { useShortPlace: false })
            : "";

        const sibInSet = (siblingIds || []).filter((sid) => sid && people[sid]);

        let siblingsSection = ``;
        if (sibInSet.length > 0) {
          const sibHtml = `
            <ul class="bullets">
              ${sibInSet
                .map(
                  (sid) =>
                    `<li>${personLinkHtml(people, sid, sn, az, { useShortPlace: true })}</li>`
                )
                .join("")}
            </ul>
          `;
          siblingsSection = `<h3>Geschwister</h3>${sibHtml}`;
        } else {
          siblingsSection = `
            <h3>Geschwister</h3>
            <div class="placeholder">Keine Angaben zu Geschwistern vorhanden.</div>
          `;
        }

        if (!fatherInSet && !motherInSet) {
          $("parentsBody").innerHTML = `
            <h3>Eltern</h3>
            <div class="placeholder">
              Keine Angaben zu Eltern und Geschwistern vorhanden.
            </div>
          `;
        } else {
          $("parentsBody").innerHTML = `
            <h3>Eltern</h3>
            <div class="kv">Vater: ${fatherHtml}</div>
            <div class="kv">Mutter: ${motherHtml}</div>
            ${parentsMarriageHtml}
            ${siblingsSection}
          `;
        }

        /* ---------------- SCOPE HINT TRIGGER (universal text) ---------------- */

        const noParentsShown = !fatherInSet && !motherInSet;

        // Hinweis nur noch in diesen Fällen:
        // - keine Eltern (im Subset sichtbar)
        // - oder Partnerblock ist komplett leer (Placeholder-Fall)
        showScopeHint = noParentsShown || noUnionsShown;

      } finally {
        renderScopeHint();
      }
    }

    load().catch((err) => {
      console.error(err);
      const personNameEl = document.getElementById("personName");
      const personLinesEl = document.getElementById("personLines");
      if (personNameEl) personNameEl.textContent = "Fehler";
      if (personLinesEl) personLinesEl.textContent = String(err);
      const u = document.getElementById("unionsBody");
      const p = document.getElementById("parentsBody");
      if (u) u.innerHTML = `<div class="placeholder">Fehler</div>`;
      if (p) p.innerHTML = `<div class="placeholder">Fehler</div>`;
      showScopeHint = true;
      renderScopeHint();
    });
  </script>
</BaseLayout>
