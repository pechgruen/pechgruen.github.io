---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const ceskyEntries = await getCollection("cesky");
const ceskyPageModules = import.meta.glob("./cesky/*.astro", { eager: true }) as Record<string, any>;
const ceskyPages = Object.values(ceskyPageModules)
  .map((mod) => mod?.chronik)
  .filter(Boolean)
  .filter((c: any) => String(c.bereich ?? "") === "Česky")
  .filter((c: any) => c.title && c.href);
const ceskyCount = ceskyEntries.length + ceskyPages.length;

const siteTitle = "Smolnice (Pechgrün)";
const description =
  "Pechgrün (Smolnice) – zaniklá obec a web, který shromažďuje její stopy.";
---

<BaseLayout title={siteTitle} description={description}>
  <!-- HERO -->
  <section class="hero">
    <h1 class="hero-title">Pechgrün / Smolnice</h1>
    <p class="hero-subtitle">Krajina · stopy · proti zapomnění</p>
    <img
      src="/images/redelbach-meiselberg.jpg"
      alt="Pechgrün – pohled od Meißlbergu na střed obce. Akvarel od Karla Redelbacha."
      class="hero-image"
    />
  </section>

  <!-- EINLADUNG -->
  <section class="pechgruen-invite">
    <p><strong>Máte vazbu na Pechgrün (Smolnici)?</strong></p>

    <p>
      Tento web shromažďuje stopy po zaniklé obci – možná k nim patří i vaše
      vzpomínky, fotografie nebo rodinné příběhy.
    </p>

    <p>Pomoci mohou i drobné informace nebo jednotlivé detaily.</p>

    <p>
      → Budu rád za každou zprávu:
      <a href="mailto:pechgruen.website@gmail.com">
        pechgruen.website@gmail.com
      </a>
    </p>
  </section>

  <!-- HAUPTTEXT -->
  <section class="section">
    <p>Pechgrün (Smolnice u Chodova) je místo, které dnes již neexistuje.</p>

    <p>
      Domy zmizely, cesty byly zasypány výsypkou a krajina nad obcí byla zcela
      nově utvářena. Na místě obce se dnes nachází vrstva skrývky z povrchové
      těžby hnědého uhlí, místy až do výšky kolem 100 metrů. Co zůstalo, jsou
      vzpomínky – a i ty jsou dnes stále vzácnější.
    </p>

    <p>
      Generace, která Pechgrün ještě zažila, z velké části odešla. Jejich děti
      zestárly, jejich hlasy slábnou. Lidé, pro které byl tento kraj kdysi
      domovem, by zřejmě měli z takovéhoto webu radost – možná by ho i
      potřebovali. Tehdy však taková možnost neexistovala.
    </p>

    <p>
      Tento web vzniká pozdě, ale ne příliš pozdě. Neobrací se už přímo k
      pamětníkům, ale k dalším generacím – k dětem a vnukům, kteří toto místo
      nikdy nepoznali, ale možná se jednou začnou ptát, odkud pocházejí. Stejně
      tak je určen i lidem bez rodinné vazby, kteří chtějí porozumět tomu, co
      znamená, když vesnice zmizí – ne válkou, ale plánovaným zásahem do
      krajiny.
    </p>

    <p>
      Cílem tohoto webu není Pechgrün znovu vytvořit ani idealizovat. Nesnaží se
      zaniklou obec obnovit. Shromažďuje stopy: fotografie, texty, kresby, mapy
      a vzpomínky. Zpřístupňuje to, co jinak existuje jen v knihách, soukromých
      archivech nebo v paměti jednotlivců.
    </p>

    <p>
      Tento web není projektem pro rychlou pozornost ani pro okamžitou spotřebu.
      Je formou předávání. Uchovává něco pro okamžik, kdy někdo začne hledat –
      možná náhodou, možná pozdě, možná až tehdy, kdy už nebude koho se zeptat.
      V tomto smyslu není památníkem, ale spíše otevřeným archivem: klidným,
      fragmentárním a vědomě neúplným.
    </p>

  </section>

  <!-- TSCHECHISCHE SEITENÜBERSICHT -->
  <section class="cesky-overview">
    <h2>Prozkoumejte Pechgrün</h2>
    <p>
      Na tomto webu je nyní k dispozici {ceskyCount} stránek v češtině.
      Objevte historii zaniklé vesnice Pechgrün, její obyvatele,
      krajinu a její proměny v průběhu času.
    </p>
    <a class="cesky-link" href="/cesky/">
      Přehled všech stránek v češtině <span aria-hidden="true">→</span>
    </a>
  </section>

  <!-- WEITERE DEUTSCHE INHALTE -->
  <section class="translation-box">
    <h2>Další obsah v němčině</h2>
    <p>
      Většina ostatních příspěvků na tomto webu je v němčině. Pokud vás
      zajímají i tyto stránky, můžete si je nechat automaticky přeložit
      do češtiny přímo ve svém prohlížeči. Automatický překlad však nemusí
      vždy správně zachytit historické místní názvy a odborné výrazy.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 0px 0 28px;
  }

  .hero-title {
    margin: 0;
    font-size: 44px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero-subtitle {
    margin: 10px 0 22px;
    color: rgba(0, 0, 0, 0.65);
  }

  .hero-image {
    width: 100%;
    height: 360px;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .section {
    padding: 10px 0;
  }

  .cesky-overview {
    margin: 2rem 0 4rem;
    padding: 1.5rem;
    background: #f4f6f3;
    border-left: 4px solid #496b50;
    border-radius: 8px;
  }

  .cesky-overview h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }

  .cesky-overview p {
    margin: 0 0 1.25rem;
  }

  .cesky-link {
    display: inline-block;
    padding: 0.85rem 1.15rem;
    background: #315c3c;
    color: white;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }

  .cesky-link:hover,
  .cesky-link:focus-visible {
    background: #23462c;
    color: white;
    text-decoration: underline;
  }

  .pechgruen-invite {
    border-left: 2px solid #ccc;
    background: #f0f0f0;
    padding: 16px 14px 14px 18px;
    margin: 12px 0;
  }

  .pechgruen-invite p:last-child {
    margin-bottom: 0;
  }

  .translation-box {
    border-left: 2px solid #ccc;
    background: #f7f7f7;
    padding: 16px 14px 14px 18px;
    margin: 0 0 0;
  }

  .translation-box h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  .translation-box p:last-child {
    margin-bottom: 0;
  }
</style>
